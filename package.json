{
  "name": "supra-verifier-solana-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local codec, witness generator and isolated Solana integration tests",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --import tsx --test tools/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check scripts tools examples/verify-proof/run.mjs package.json tsconfig.json .github",
    "test:integration": "node --import tsx examples/verify-proof/run.mjs",
    "check:release": "node scripts/check-release.mjs",
    "catalog:update": "node scripts/update-catalog.mjs",
    "fixtures:capture": "node --import tsx scripts/capture-pairs.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "1.8.0",
    "@solana/web3.js": "1.99.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@solana/web3.js": {
      "jayson": "5.0.0"
    },
    "rpc-websockets@^9.0.0": "9.3.8"
  }
}
